# Processado pelo envsubst da imagem oficial do Nginx (variáveis ${...}).
server {
    listen 80;
    server_name _;
    server_tokens off;

    client_max_body_size 8m;

    resolver 127.0.0.11 valid=30s ipv6=off;

    # Câmera ao vivo: o navegador acessa /camera/stream no próprio site e o
    # Nginx repassa ao Raspberry (com o token), somente para usuários logados.
    location = /camera/stream {
        auth_request /camera/autorizar-interno;

        set $raspberry http://${RASPBERRY_HOST}:${RASPBERRY_PORT};
        proxy_pass $raspberry/video_feed;
        proxy_set_header X-Api-Key "${RASPBERRY_TOKEN}";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        proxy_connect_timeout 3s;
    }

    location = /camera/autorizar-interno {
        internal;
        proxy_pass http://app:80/camera/autorizar;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $host;
        proxy_set_header Cookie $http_cookie;
    }

    location / {
        proxy_pass http://app:80;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Parar gravação inclui conversão e download do vídeo.
        proxy_read_timeout 330s;
    }
}
