# Arquivos enviados pelos usuários nunca são executados como código.
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .phar .php3 .php4 .php5 .php7 .php8 .pht
RemoveType .php .phtml .phar .php3 .php4 .php5 .php7 .php8 .pht

<FilesMatch "\.(?i:php\d?|phtml|phar|pht|cgi|pl|py|sh)$">
    Require all denied
</FilesMatch>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>

# Vídeos antigos ficam bloqueados; agora são entregues por /gravacao/download.
<IfModule mod_rewrite.c>
    RewriteEngine on
    RewriteRule ^UploadsVideos/ - [F,L]
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
