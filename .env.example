# Copie para .env e ajuste. NUNCA versione o arquivo .env.

# Mostrar erros detalhados (somente em desenvolvimento)
APP_DEBUG=false
# URL pública usada em links de e-mail (evita links forjados pelo cabeçalho Host)
APP_URL=http://localhost

# Banco de dados (no Docker, DB_HOST=db e DB_PORT=3306)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=CEBIOHUB
DB_USER=farmview
DB_PASS=troque-esta-senha
# Usado apenas pelo container do MySQL
DB_ROOT_PASS=troque-esta-senha-root

# SMTP para recuperação de senha (Gmail: use uma "senha de app")
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=FarmView

# Raspberry Pi (serviço Flask)
RASPBERRY_HOST=192.168.0.127
RASPBERRY_PORT=5000
# Mesmo valor de FARMVIEW_TOKEN no Raspberry. Gere com: openssl rand -hex 32
RASPBERRY_TOKEN=
